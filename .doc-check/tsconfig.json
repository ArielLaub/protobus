{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2022",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "noImplicitAny": false,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": false,
        "outDir": "out",
        "rootDir": "src",
        "lib": [
            "ES2022",
            "dom"
        ],
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*"
    ]
}